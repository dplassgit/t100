0 CLS:P1=3.14159/180: REM pi/180
5 DEFINTX,Y:FORI=0TO6:READA(I):NEXT
20 XC=240/2:YC=64/2:I=0
30 FOR TH=1TO795
45 RAD=TH*P1
47 D=TH/24
50 X=XC+D*COS(RAD)
60 Y=YC+D*SIN(RAD)
70 PSET(X, Y):REMPRINT@0,X,Y
90 IF (THMOD100)=0 AND I < 7 THEN PRINT@(X\6+40*(Y\8)+1),CHR$(A(I));:I=I+1
110 NEXT
200 DATA 69,88,80,82,69,83,83,0
