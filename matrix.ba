5 CLS:PRINTCHR$(27)"V":REM no scroll
10 C$=".,'`^" + CHR$(34) + ":;!+lITLCUOXzonxPqdbkga*ZMW08#B@$&"
15 DEFINT A-Z:H=6:MC=4:MR=16:REM line height, max co, max row
20 DIM X(MC),Y(MC):REM x(n)&y(n) are the col and row
25 N=0:T=RND(-VAL(RIGHT$(TIME$,2)))
30 IFN>=MCTHEN60
40 C=40*RND(1)+1:N=N+1:X(N)=C:Y(N)=5*RND(1)
60 FORI=1TON:IFX(I)=0THEN145
65 R=Y(I):IFR>=MRTHEN110
70 P=1+2*R+8*RND(1):PRINT@(R*40+X(I)-1),MID$(C$,P,1);:Y(I)=R+1:GOTO150
100 REM reclaim slot
110 Y(I)=0:X(I)=0:IFN>1THENX(I)=X(N):Y(I)=Y(N)
140 N=N-1
145 I=99:REM stop iterating
150 NEXT:IFRND(1)<.5THEN60ELSE30
